<UserControl x:Class="TJCServiceDesk.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18,18,18,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#18181D" CornerRadius="12" Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="TJC COMMUNITY" Foreground="White" FontWeight="Bold" FontSize="13" Margin="8,8,0,14"/>
                <Button Grid.Row="1" Command="{Binding OpenAnnouncementsCommand}" HorizontalContentAlignment="Stretch" Padding="10,9" Margin="0,2,0,12" Background="#30283F" BorderThickness="0" ToolTip="Open announcements">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="#" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="mededelingen" Foreground="White"/></StackPanel><Border Grid.Column="1" Background="#EF4444" CornerRadius="9" Padding="6,1" Visibility="{Binding IsUnreadAnnouncementVisible, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding UnreadAnnouncementCount}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></Grid>
                </Button>
                <TextBlock Grid.Row="2" Text="DIRECT MESSAGES" Foreground="#858591" FontWeight="SemiBold" FontSize="10" Margin="8,3,0,8"/>
                <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding FriendTagInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Naam#2153" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#202027" Foreground="White" BorderBrush="#2B2B35"/><Button Grid.Column="1" Content="＋" ToolTip="Add Friend" Command="{Binding AddFriendCommand}" Margin="6,0,0,0" Padding="10,5" Background="{DynamicResource AccentPrimaryBrush}"/></Grid>
                <ListBox Grid.Row="4" ItemsSource="{Binding Friends}" Background="Transparent" BorderThickness="0" Margin="0,0,0,8">
                    <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenDirectMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="5,5" Margin="0,1"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="#343440"><Grid><TextBlock Text="{Binding UserName}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProfilePicturePath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/></Image.Clip><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding ProfilePicturePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding UserName}" Foreground="#D1D1D8" FontSize="12"/><TextBlock Text="{Binding DisplayTag}" Foreground="#777783" FontSize="9"/><TextBlock Foreground="#777783" FontSize="9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Offline"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Text" Value="Online"/><Setter Property="Foreground" Value="#4ADE80"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="5" Background="#202027" CornerRadius="9" Padding="9" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="19" Background="#373442"><Grid><TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProfilePicturePath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding ProfilePicturePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><StackPanel Margin="9,2,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding UserTag, StringFormat=Online · {0}}" Foreground="#9CA3AF" FontSize="10"/></StackPanel><Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#18181D" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentChatTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding CanManageAnnouncementRoles, Converter={StaticResource BoolToVisibility}}"><TextBox Text="{Binding AnnouncerTagInput, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="32" VerticalContentAlignment="Center" Padding="8,0" Background="#202027" Foreground="White" BorderBrush="#2B2B35" ToolTip="Naam#4821"/><Button Content="＋ Beheer schrijfrechten" Command="{Binding ToggleAnnouncerCommand}" Margin="8,0,0,0" Padding="10,4" Background="{DynamicResource AccentPrimaryBrush}"/></StackPanel></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5,8"><Border Width="38" Height="38" CornerRadius="19" Background="#343440" VerticalAlignment="Top"><Grid><TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProfilePicturePath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="19,19" RadiusX="19" RadiusY="19"/></Image.Clip><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding ProfilePicturePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><StackPanel Margin="11,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding UserName}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding UserTag, StringFormat= · {0}}" Foreground="#777783" FontSize="10" Margin="4,2,0,0"/><TextBlock Text="{Binding TimeLabel}" Foreground="#777783" FontSize="10" Margin="8,2,0,0"/></StackPanel><TextBlock Text="{Binding Text}" Foreground="#D3D3DA" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Grid Grid.Row="2" Margin="0,8,0,8"><Grid Visibility="{Binding CanSendCurrentChat, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="100" MinHeight="42" VerticalContentAlignment="Center" Padding="12,8" Background="#202027" Foreground="White" BorderBrush="#2B2B35" ToolTip="Ctrl+Enter to send" KeyDown="Message_KeyDown"/><TextBlock Text="{Binding MessagePlaceholder}" Foreground="#777783" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsMessageTextEmpty, Converter={StaticResource BoolToVisibility}}"/></Grid><Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" Background="{DynamicResource AccentPrimaryBrush}"/></Grid><Border Background="#202027" CornerRadius="8" Padding="12" Visibility="{Binding ShowAnnouncementReadOnlyNotice, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Alleen beheerders kunnen berichten plaatsen in #mededelingen." Foreground="#A0A0AA" TextWrapping="Wrap"/></Border></Grid>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#9CA3AF" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </Grid>
        <Border Grid.Column="2" Background="#18181D" CornerRadius="12" Padding="13"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ACTIVE COMMUNITY" Foreground="#858591" FontSize="10" FontWeight="SemiBold" Margin="4,8,0,14"/><ListBox ItemsSource="{Binding CommunityMembers}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="3,7"><Border Width="30" Height="30" CornerRadius="15" Background="#343440"><Grid><TextBlock Text="{Binding UserName}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProfilePicturePath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/></Image.Clip><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding ProfilePicturePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid></Border><StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding UserName}" Foreground="#D1D1D8" FontSize="11"/><TextBlock Text="{Binding DisplayTag}" Foreground="#777783" FontSize="9"/><TextBlock Foreground="#777783" FontSize="9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Offline"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Text" Value="Online"/><Setter Property="Foreground" Value="#4ADE80"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    </Grid>
</UserControl>

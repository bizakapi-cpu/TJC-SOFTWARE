<UserControl x:Class="TJCServiceDesk.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#292932" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#322A45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#18181D" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2B2B35" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#322A45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Music" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="Your local library, YouTube search, recent songs, and favorites" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
            <Button Content="＋  Scan music folder" Command="{Binding ScanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentPrimaryBrush}" Padding="16,10"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border CornerRadius="8" Background="#18181D" BorderThickness="1" Padding="12,0" Height="42" VerticalAlignment="Center">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#2B2B35"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <DockPanel LastChildFill="True"><TextBlock Text="⌕" Foreground="#9CA3AF" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,2"/><Grid><TextBox x:Name="SearchQueryTextBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" CaretBrush="White" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Search YouTube for songs, artists, or albums" GotFocus="SearchQuery_GotFocus"/><TextBlock Text="Search YouTube for songs, artists, or albums..." Foreground="#777783" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
                    <Popup IsOpen="{Binding IsSearchHistoryOpen, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchQueryTextBox}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Background="#18181D" BorderBrush="#3A3A46" BorderThickness="1" CornerRadius="8" Width="440" MaxHeight="320" Padding="6" Margin="0,3,0,0">
                        <ListBox ItemsSource="{Binding RecentSearches}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.SearchHistorySelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#E5E5EB" BorderThickness="0" Padding="10,8"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    </Popup>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="Search YouTube" Command="{Binding SearchYouTubeCommand}" Margin="10,0,0,0" Padding="18,8" Background="{DynamicResource AccentPrimaryBrush}" IsEnabled="{Binding CanSearch}"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Library" Command="{Binding NavigateSectionCommand}" CommandParameter="Library" Margin="0,0,6,0"/>
                <Button Content="Search results" Command="{Binding NavigateSectionCommand}" CommandParameter="Search" Margin="0,0,6,0"/>
                <Button Content="Recent gezocht" Command="{Binding NavigateSectionCommand}" CommandParameter="Recent" Margin="0,0,6,0"/>
                <Button Content="♥ Favorites" Command="{Binding NavigateSectionCommand}" CommandParameter="Favorites"/>
            </StackPanel>
            <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#18181D" Foreground="White" BorderBrush="#2B2B35" ToolTip="Filter local library"/><TextBlock Text="Filter library..." Foreground="#777783" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" DisplayMemberPath="Name" Height="38" VerticalContentAlignment="Center" Background="#18181D" Foreground="White" BorderBrush="#2B2B35" BorderThickness="1" Padding="10,0">
                <ComboBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#18181D"/><SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#18181D"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#322A45"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/></ComboBox.Resources>
                <ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"/><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/><Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#18181D" BorderBrush="#2B2B35" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MaxHeight="320"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></ComboBox.Template>
            </ComboBox>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="＋ Playlist" Command="{Binding AddSelectedToPlaylistCommand}" Margin="0,0,8,0"/><Button Content="Delete" Command="{Binding DeletePlaylistCommand}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Border Background="#18181D" BorderBrush="#2B2B35" BorderThickness="1" CornerRadius="12">
                <ListView ItemsSource="{Binding FilteredTracks}" SelectedItem="{Binding SelectedTrack}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseRightButtonDown="Tracks_PreviewMouseRightButtonDown">
                    <ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Library"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListView.Style>
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="4,1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#292932"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#322A45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                    <ListView.View><GridView AllowsColumnReorder="False"><GridViewColumn Header="#" Width="42"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="♫" Foreground="#9B9BA6" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="TRACK" Width="390"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding CoverPath}" Width="40" Height="40" Stretch="UniformToFill"/><StackPanel Margin="11,3,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="#9B9BA6" FontSize="11"/></StackPanel></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="ALBUM" Width="180" DisplayMemberBinding="{Binding Album}"/><GridViewColumn Header="TIME" Width="70" DisplayMemberBinding="{Binding Duration}"/><GridViewColumn Header="" Width="54"><GridViewColumn.CellTemplate><DataTemplate><Button Content="♥" ToolTip="Add or remove from favorites" Command="{Binding DataContext.ToggleTrackFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View>
                    <ListView.ContextMenu><ContextMenu><MenuItem Header="Play" Command="{Binding PlacementTarget.DataContext.PlaySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Add to selected playlist" Command="{Binding PlacementTarget.DataContext.AddSelectedToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></ListView.ContextMenu>
                    <ListView.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding PlaySelectedCommand}"/></ListView.InputBindings>
                </ListView>
            </Border>
            <ListView ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Search"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListView.Style>
                <ListView.ItemTemplate><DataTemplate><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding ThumbnailUrl}" Width="48" Height="48" Stretch="UniformToFill"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding Duration}" Foreground="#777783" FontSize="10"/></StackPanel><Button Grid.Column="2" Content="Open" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Grid.Column="3" Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Add or remove from favorites"/></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <ListView ItemsSource="{Binding RecentSongs}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Recent"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListView.Style>
                <ListView.ItemTemplate><DataTemplate><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding ThumbnailUrl}" Width="48" Height="48" Stretch="UniformToFill"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding SearchQuery}" Foreground="#777783" FontSize="10"/></StackPanel><Button Grid.Column="2" Content="Open / Play" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Grid.Column="3" Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Add or remove from favorites"/></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <ListView ItemsSource="{Binding FavoriteSongs}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Style><Style TargetType="ListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Favorites"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListView.Style>
                <ListView.ItemTemplate><DataTemplate><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding ThumbnailUrl}" Width="48" Height="48" Stretch="UniformToFill"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#9CA3AF" FontSize="11"/><TextBlock Text="{Binding Duration}" Foreground="#777783" FontSize="10"/></StackPanel><Button Grid.Column="2" Content="Play / Open" Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Grid.Column="3" Content="♥" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remove from favorites"/></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBox Grid.Column="1" Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#202027" Foreground="White" BorderBrush="#2B2B35" ToolTip="New playlist name"/><Button Grid.Column="2" Content="Create" Command="{Binding CreatePlaylistCommand}" Margin="8,0,0,0"/></Grid>
    </Grid>
</UserControl>

<UserControl x:Class="TJCServiceDesk.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TJCServiceDesk.Controls"
             Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,30">
        <TextBlock Text="Dashboard" Foreground="White" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="A live view of your system" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,26" />
        <UniformGrid Columns="2" Rows="3">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,12,12"><StackPanel><TextBlock Text="CPU LOAD" Foreground="#9999A5" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Cpu}" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,14,0,4"/><TextBlock Text="{Binding CpuTemperature, StringFormat='Temperature · {0}'}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,12"><StackPanel><TextBlock Text="GPU LOAD" Foreground="#9999A5" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Gpu}" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,14,0,4"/><TextBlock Text="{Binding GpuTemperature, StringFormat='Temperature · {0}'}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,12,12"><StackPanel><TextBlock Text="MEMORY" Foreground="#9999A5" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Ram}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,14,0,4"/><TextBlock Text="System memory" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,12"><StackPanel><TextBlock Text="NETWORK" Foreground="#9999A5" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Network}" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,18,0,8"/><TextBlock Text="Current traffic" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
        </UniformGrid>
        <controls:StatusPill Text="{Binding Notice}" Margin="0,6,0,0" />
    </StackPanel></ScrollViewer>
</UserControl>

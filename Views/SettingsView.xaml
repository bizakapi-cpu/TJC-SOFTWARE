<UserControl x:Class="TJCServiceDesk.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26" MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="Personalize your service desk" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,24"/>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <StackPanel><TextBlock Text="PROFILE" Foreground="#9999A5" FontWeight="SemiBold" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#343440" ClipToBounds="True">
                        <Grid><TextBlock Text="{Binding UserName}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Image Source="{Binding ProfilePicturePath}" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/></Image.Clip><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding ProfilePicturePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><Button Content="Upload Profile Picture" Command="{Binding UploadProfilePictureCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding UserDisplayTag}" Foreground="#9CA3AF" Margin="0,8,0,0"/></StackPanel>
                </StackPanel>
                <TextBlock Text="Display name" Foreground="White" Margin="0,18,0,8"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="#18181D" Foreground="White" BorderBrush="#2B2B35"/>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
            <StackPanel><TextBlock Text="APPEARANCE" Foreground="#9999A5" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Accent color" Foreground="White" Margin="0,16,0,10"/>
                <ItemsControl ItemsSource="{Binding AccentSwatches}" HorizontalAlignment="Left"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="40" Height="40" Padding="3" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding Name}" Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}"><Border Width="34" Height="34" Background="{Binding Hex}" CornerRadius="17" BorderThickness="2"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="STARTUP" Foreground="#9999A5" FontWeight="SemiBold" FontSize="11"/><CheckBox Content="Launch TJC Service Desk when Windows starts" IsChecked="{Binding LaunchAtStartup}" Foreground="White" Margin="0,16,0,0"/></StackPanel></Border>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="LIBRARIES" Foreground="#9999A5" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Music folder" Foreground="White" Margin="0,16,0,8"/><DockPanel><TextBox Text="{Binding MusicFolder}" IsReadOnly="True" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#18181D" Foreground="#BDBDC7" BorderBrush="#2B2B35"/><Button Content="Choose &amp; scan" Command="{Binding ChooseMusicFolderCommand}" Margin="8,0,0,0"/></DockPanel><TextBlock Text="Additional game folder" Foreground="White" Margin="0,16,0,8"/><DockPanel><TextBox Text="{Binding GameFolder}" IsReadOnly="True" Height="36" VerticalContentAlignment="Center" Padding="10,0" Background="#18181D" Foreground="#BDBDC7" BorderBrush="#2B2B35"/><Button Content="Choose &amp; scan" Command="{Binding ChooseGameFolderCommand}" Margin="8,0,0,0"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Rescan music" Command="{Binding RescanMusicCommand}"/><Button Content="Rescan game libraries" Command="{Binding RescanGamesCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
        <TextBlock Text="{Binding Status}" Foreground="#C4B5FD" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</UserControl>

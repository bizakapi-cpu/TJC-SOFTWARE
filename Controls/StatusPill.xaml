<UserControl x:Class="TJCServiceDesk.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="#24212D" CornerRadius="9" Padding="14,8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="{Binding Text, ElementName=Root}" Foreground="#C4B5FD" FontSize="12" />
    </Border>
</UserControl>
